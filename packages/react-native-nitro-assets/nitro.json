{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["assets"],
  "ios": {
    "iosModuleName": "NitroAssets"
  },
  "android": {
    "androidNamespace": ["assets"],
    "androidCxxLibName": "NitroAssets"
  },
  "autolinking": {
    "AssetPacks": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridAssetPacks"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridAssetPacks"
      }
    }
  },
  "ignorePaths": ["**/node_modules"]
}
