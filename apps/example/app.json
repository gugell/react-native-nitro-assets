{
  "expo": {
    "name": "Nitro Assets Example",
    "slug": "nitro-assets-example",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.gugell.nitroassets.example",
      "supportsTablet": true
    },
    "android": { "package": "com.gugell.nitroassets.example" },
    "web": { "bundler": "metro", "output": "single" },
    "plugins": [
      [
        "react-native-nitro-assets",
        {
          "packs": { "demo-pack": { "path": "./asset-packs/demo-pack" } },
          "ios": {
            "backgroundAssets": {
              "appGroupId": "group.com.gugell.nitroassets.example",
              "packs": { "demo-pack": "essential" }
            },
            "odr": { "packs": { "demo-pack": "on-demand" } }
          },
          "android": { "playAssetDelivery": { "packs": { "demo-pack": "fast-follow" } } }
        }
      ]
    ]
  }
}
