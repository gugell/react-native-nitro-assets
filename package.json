{
  "name": "react-native-nitro-assets-repo",
  "private": true,
  "version": "0.0.0",
  "packageManager": "bun@1.4.5",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "specs": "bun run --cwd packages/react-native-nitro-assets specs",
    "build": "bun run --cwd packages/react-native-nitro-assets build",
    "typecheck": "bun run --cwd packages/react-native-nitro-assets typecheck && bun run --cwd apps/example typecheck",
    "test": "bun run --cwd packages/react-native-nitro-assets test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generated:check": "node scripts/check-generated.mjs",
    "pack:check": "node scripts/pack-check.mjs",
    "check": "bun run build && bun run typecheck && bun run lint && bun run format:check && bun run test",
    "example": "bun run --cwd apps/example",
    "release": "bash ./scripts/release.sh",
    "release:dry-run": "bash ./scripts/release.sh --dry-run",
    "release:check": "bash ./scripts/check-release-script.sh",
    "release:first": "bash ./scripts/first-publish.sh"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@release-it/bumper": "8.0.1",
    "@release-it/conventional-changelog": "12.0.2",
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "release-it": "21.1.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "release-it": {
    "npm": {
      "publish": false
    },
    "git": {
      "requireBranch": "main",
      "requireUpstream": true,
      "requireCleanWorkingDir": false,
      "commitMessage": "chore: release v${version}",
      "tagName": "v${version}",
      "addUntrackedFiles": true
    },
    "github": {
      "release": true,
      "releaseName": "v${version}"
    },
    "hooks": {
      "after:bump": "bun install"
    },
    "plugins": {
      "@release-it/bumper": {
        "out": [
          {
            "file": "packages/react-native-nitro-assets/package.json",
            "path": "version"
          },
          {
            "file": "apps/example/package.json",
            "path": "version"
          }
        ]
      },
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "conventionalcommits",
          "types": [
            {
              "type": "feat",
              "section": "Features"
            },
            {
              "type": "fix",
              "section": "Bug Fixes"
            },
            {
              "type": "perf",
              "section": "Performance"
            },
            {
              "type": "docs",
              "section": "Documentation"
            },
            {
              "type": "chore(deps)",
              "section": "Dependencies"
            }
          ]
        },
        "infile": "packages/react-native-nitro-assets/CHANGELOG.md"
      }
    }
  }
}
